# Copy this file to .env and fill in real values.
# Atlas (recommended): mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<app-name>
# Local fallback: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bank_application?retryWrites=true&w=majority&appName=BankAPI
MONGODB_DB_NAME=bank_application

# Optional auth settings (if your MongoDB requires authentication)
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Optional collection names
MONGODB_USERS_COLLECTION=users
MONGODB_ACCOUNTS_COLLECTION=accounts
MONGODB_TRANSACTIONS_COLLECTION=transactions

# App settings
APP_ENV=development
APP_PORT=8000

# Authentication (generate a long random value; never commit the real secret).
# JWT_SECRET_KEY may be omitted when an ignored .jwt-secret file is used.
JWT_SECRET_KEY=<at-least-32-random-characters>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=bank-application
JWT_AUDIENCE=bank-application-api

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173
