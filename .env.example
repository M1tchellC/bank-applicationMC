# Copy this file to .env and fill in real values.
# Atlas (recommended): mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<app-name>
# Local fallback: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bank_application?retryWrites=true&w=majority&appName=BankAPI
MONGODB_DB_NAME=bank_application

# Optional auth settings (if your MongoDB requires authentication)
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Optional collection names
MONGODB_USERS_COLLECTION=users
MONGODB_ACCOUNTS_COLLECTION=accounts
MONGODB_TRANSACTIONS_COLLECTION=transactions

# App settings
APP_ENV=development
APP_PORT=8000
